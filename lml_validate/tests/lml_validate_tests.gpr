with "config/lml_validate_tests_config.gpr";
with "config/lml_validate_tests_list_config.gpr";

project Lml_Validate_Tests is
   for Source_Dirs use ("src/**", "common/", "config/");
   for Object_Dir use "obj/" & Lml_Validate_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use Lml_Validate_Tests_List_Config.Test_Files;

   package Compiler is
      for Default_Switches ("Ada") use
        Lml_Validate_Tests_Config.Ada_Compiler_Switches;
      for Local_Configuration_Pragmas use "test_pragmas.adc";
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;
end Lml_Validate_Tests;
